# server
DEKO_PORT=8000
DEKO_ENV=dev
# min 8 chars; bootstrap admin password (sessions are issued on login)
DEKO_ADMIN_PASSWORD=change-me-please

# storage (sqlite only in this build; postgres returns as a future data layer)
DEKO_DATABASE_URL=sqlite://data/deko.db
# optional read replica url (reserved; today resolves to the writer)
# DEKO_DATABASE_READ_URL=

# llm providers - every configured provider joins the fallback chain,
# LLM_DEFAULT_PROVIDER is tried first (gemini|openai|anthropic|ollama|azure|bedrock|custom)
LLM_DEFAULT_PROVIDER=gemini
LLM_DEFAULT_MODEL=gemini-2.0-flash

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECS=30

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECS=30

# security
# min 16 chars; mixed into api key hashes - treat like a root secret
DEKO_API_KEY_SECRET=generate-a-secure-random-string-here

# cors allowlist enforced by the router; prod profile rejects "*"
DEKO_ALLOWED_ORIGINS=http://localhost:8000

# rate limiting (per ip, sliding window)
DEKO_RATE_LIMIT_PER_MINUTE=60

# request limits
DEKO_MAX_SCREENSHOT_SIZE_MB=10
DEKO_MAX_REQUEST_BODY_KB=512

# background processor
DEKO_PROCESSOR_POLL_INTERVAL_SECS=2
# pending actions older than this are auto-denied (fail-closed)
# DEKO_ACTION_TTL_SECS=3600

# policy engine dry run: log would-be denials without enforcing
# DEKO_POLICY_DRY_RUN=1

# verdict webhooks (denied/escalated); signatures are hmac-sha256 over
# timestamp.payload when DEKO_WEBHOOK_SECRET is set
DEKO_WEBHOOK_URL=
DEKO_WEBHOOK_SECRET=

# pre-migration sqlite file backups
# DEKO_BACKUP_DIR=./backups
